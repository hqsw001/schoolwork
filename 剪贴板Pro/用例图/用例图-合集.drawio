        </mxCell>
        <mxCell id="i11" value="11. UC-04 配置存储容量上限 → UC-18 应用配置持久化" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1B5E20;" vertex="1" parent="1">
          <mxGeometry x="150" y="490" width="650" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="i12" value="12. UC-20 启动初始化与历史恢复 → UC-03 持久化保存记录" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1B5E20;" vertex="1" parent="1">
