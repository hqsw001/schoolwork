# ============================================================
#  剪贴板Pro —— Git 忽略规则
# ============================================================
#  本仓库是**公开仓库**。下面第 1、2 节是硬性红线：
#  隐私数据和密钥任何时候都不许提交。
#
#  自检命令（提交前跑一下，应当没有任何输出）：
#      git status --porcelain | findstr /I ".data .db .pyc"
#      git ls-files | findstr /I ".data .db .pyc key .env"
# ============================================================


# ------------------------------------------------------------
# 1. 运行时数据目录 —— 最要紧的一类
# ------------------------------------------------------------
# .data/ 是程序真实的数据目录，里面全是**本机剪贴板历史**：
#     clipboardpro.db     复制过的全部文本/图片/文件记录
#                         （可能含密码、私聊记录、身份证号等）
#     clipboardpro.log    运行日志（含本机绝对路径、窗口句柄）
#     attachments/*.png   截图与被复制图片的原始位图
# 属于纯个人数据，与源码无关，绝不上传。
.data/
.data

# 数据库文件一律不入库（schema 在 sql/*.sql 里，那才是要提交的）
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3


# ------------------------------------------------------------
# 2. 密钥 / 凭据（api_key、token、密码）
# ------------------------------------------------------------
.env
.env.*
!.env.example

*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore

secrets.json
secret.json
credentials.json
credentials.*
token.json
tokens.json
config.local.*
settings.local.*
*.secret

# 常见的密钥备份/导出文件
*_key.txt
*_secret*
*apikey*
*api_key*


# ------------------------------------------------------------
# 3. Python 编译产物与各类缓存
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

.Python
build/
dist/
*.egg-info/
.eggs/

.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/


# ------------------------------------------------------------
# 4. 虚拟环境
# ------------------------------------------------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/


# ------------------------------------------------------------
# 5. 编辑器与操作系统
# ------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
\#*\#
.\#*

Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
